# 买股工具室后端环境变量
# ⚠️ 不提交到 git(已在 .gitignore)

# FERNET Key 用于加密 API Key(v2.1,首次启动会自动生成)
FERNET_KEY=

# LLM API Keys(v2.1 改造:不在 .env 配,用户通过设置页 UI 输入)
# 保留字段用于 v2.0 兼容:启动时若 llm_api_keys 表为空且 .env 有 Key,自动迁移到加密表
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
DOUBAO_API_KEY=

# 默认 Provider
LLM_DEFAULT_PROVIDER=deepseek

# 数据源
AKSHARE_ENABLED=true

# 数据库
DATABASE_URL=sqlite+aiosqlite:///./data.db

# 日志目录
LOG_DIR=./logs