diff --git a/backend/app/data/ifind_fundamentals.py b/backend/app/data/ifind_fundamentals.py new file mode 100644 index 0000000..d10ce99 --- /dev/null +++ b/backend/app/data/ifind_fundamentals.py @@ -0,0 +1,58 @@ +"""thsifind search_securities 包装层 (改动 B) + +screener Top N 基本面兜底过滤用.""" +from __future__ import annotations + +from typing import Any + +from app.data.ifind_events import IfindUnavailable  # 复用统一异常 + + +try: +    from mcode_tools_connector import call as _mcode_call +except ImportError: +    _mcode_call = None + + +async def _search_securities(market: str, query: str) -> list[dict[str, Any]]: +    if _mcode_call is None: +        raise IfindUnavailable("mcode-tools connector 未安装") +    return await _mcode_call( +        "thsifind__search_securities", +        {"market": market, "query": query}, +    ) + + +async def is_hit_fundamental_filter(stock_code: str, query: str, market: str = "A股") -> bool: +    """单只票是否命中基本面筛条件. + +    Args: +        stock_code: 6 位股票代码 (规整后) +        query: 筛条件字符串 (e.g. "扣非ROE>0 PE<行业中位数 剔除ST") +        market: 默认 A 股 + +    Returns: +        True = 命中 (通过筛条件), False = 不命中 (踢出) + +    Raises: +        IfindUnavailable: ifind 调用失败 +    """ +    try: +        raw = await _search_securities(market=market, query=query) +    except Exception as e: +        raise IfindUnavailable(f"search_securities 失败: {e}") from e + +    if not isinstance(raw, list): +        raise IfindUnavailable(f"search_securities 返回非 list: {type(raw).__name__}") + +    norm = stock_code.upper().strip() +    for r in raw: +        if not isinstance(r, dict): +            continue +        code = r.get("stock_code") +        if isinstance(code, str) and code.upper().strip() == norm: +            return bool(r.get("hit", False)) +    return False + + +__all__ = ["is_hit_fundamental_filter"] \ No newline at end of file diff --git a/backend/tests/test_ifind_fundamentals.py b/backend/tests/test_ifind_fundamentals.py new file mode 100644 index 0000000..927bb89 --- /dev/null +++ b/backend/tests/test_ifind_fundamentals.py @@ -0,0 +1,50 @@ +"""ifind_fundamentals 包装层测试 (改动 B)""" +import pytest + + +@pytest.mark.asyncio +async def test_is_hit_returns_true_when_stock_in_results(): +    from app.data.ifind_fundamentals import is_hit_fundamental_filter +    from tests.conftest import mock_thsifind + +    raw = [ +        {"stock_code": "600519.SH", "hit": True}, +        {"stock_code": "000001.SZ", "hit": False}, +    ] +    with mock_thsifind(securities=raw): +        hit = await is_hit_fundamental_filter("600519.SH", "扣非ROE>0") + +    assert hit is True + + +@pytest.mark.asyncio +async def test_is_hit_returns_false_when_stock_not_in_results(): +    from app.data.ifind_fundamentals import is_hit_fundamental_filter +    from tests.conftest import mock_thsifind + +    raw = [{"stock_code": "OTHER.SH", "hit": True}] +    with mock_thsifind(securities=raw): +        hit = await is_hit_fundamental_filter("600519.SH", "扣非ROE>0") + +    assert hit is False + + +@pytest.mark.asyncio +async def test_is_hit_empty_results_returns_false(): +    from app.data.ifind_fundamentals import is_hit_fundamental_filter +    from tests.conftest import mock_thsifind + +    with mock_thsifind(securities=[]): +        hit = await is_hit_fundamental_filter("600519.SH", "扣非ROE>0") + +    assert hit is False + + +@pytest.mark.asyncio +async def test_is_hit_failure_raises(): +    from app.data.ifind_fundamentals import is_hit_fundamental_filter, IfindUnavailable +    from tests.conftest import mock_thsifind + +    with mock_thsifind(fail_on={"search_securities"}): +        with pytest.raises(IfindUnavailable): +            await is_hit_fundamental_filter("600519.SH", "扣非ROE>0") \ No newline at end of file
