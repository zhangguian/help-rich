# 根目录 .gitignore(2026-08-01 新增)

# 截图上传目录(P8 后端服务运行时生成,不入库)
uploads/

# admin 备份目录(v0.2.1 后端运行时生成,不入库)
backups/

# 临时验证数据(开发库 / 测试库)
backend/data*.db
backend/data/*.db
backend/data.db
# SQLite 运行时伴生文件(WAL 模式下必然生成,可达数百 MB,绝不入库)
backend/data.db-wal
backend/data.db-shm
*.db-wal
*.db-shm

# 测试临时目录(conftest 建在工作区内,避开系统 tmp 的沙箱权限限制)
backend/.pytest_tmp/
.pytest_tmp/
.tmp_test/
# pytest 自带的 tmp_path scratch 基目录(默认 <tmp>/pytest-of-<user>,
# 某些环境下 TMP 指向工程目录,于是落到 backend/pytest-of-<user>/)
pytest-of-*/

# 对标参考源码(临时解压,不入库)
.tmp_panwatch/

# 临时日志
*.log
C:/Users/20274/AppData/Local/Temp/opencode/

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Node
node_modules/
.next/
.pnpm-store/

# 环境变量
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp